<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>otAPI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <RootNamespace>_otAPI</RootNamespace>
  </PropertyGroup>
  <Target Name="MoveAssembly" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProjectDir)../../On-Together/BepInEx/plugins/otAPI/" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ProjectDir)../Exports" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="otAPI/**/*">
      <LogicalName>$([System.String]::new('%(RelativeDir)').Replace('\','/'))%(FileName)%(Extension)</LogicalName>
